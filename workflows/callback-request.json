    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  // Read from body.phone (Webhook structure)\n  const raw = (item.json.body && item.json.body.phone)\n    ? item.json.body.phone\n    : (item.json.phone || \"\");\n\n  const digits = raw.replace(/\\D/g, \"\");\n\n  if (digits.length === 10) {\n    const area = digits.slice(0, 3);\n    const mid = digits.slice(3, 6);\n    const last = digits.slice(6, 10);\n\n    item.json.normalizedPhone = `(${area}) ${mid}-${last}`;\n  } else {\n    item.json.normalizedPhone = raw;\n  }\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
