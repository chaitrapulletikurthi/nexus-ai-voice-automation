        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize input from Webhook -> body.city\nconst cityRaw = (\n  ($json.body && $json.body.city) ??\n  $json.city ??\n  ''\n).toString().trim();\n\nif (!cityRaw) {\n  return { error: 'Missing required field: city' };\n}\n\nconst city = cityRaw.replace(/\\s+/g, ' ').trim();\nconst limit = 1; // prototype: 1 result\n\nreturn { city, limit };"
      },
