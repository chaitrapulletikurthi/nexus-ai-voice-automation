    {
      "parameters": {
        "jsCode": "if (items.length === 0) {\n  return {\n    notFound: true,\n    speech: \"I couldn't find any available deals in that city right now. Want me to check a nearby city?\"\n  };\n}\n\nconst rec = items[0].json;\n\nconst city  = rec[\"City\"] || \"that city\";\nconst addr  = rec[\"Full Address\"] || rec[\"Address\"] || \"an unspecified address\";\nconst beds  = rec[\"Bed Count\"] ?? rec[\"Beds\"] ?? \"N/A\";\nconst baths = rec[\"Bath Count\"] ?? rec[\"Baths\"] ?? \"N/A\";\nconst sqft  = rec[\"Square Footage\"] ?? rec[\"Sq Ft\"] ?? \"N/A\";\nconst price = rec[\"Asking Price\"] ?? rec[\"Price\"] ?? rec[\"List Price\"] ?? \"N/A\";\n\nconst speech = `I found one deal in ${city}: ${addr}. It’s ${beds} bed, ${baths} bath, around ${sqft} square feet, asking ${price}. Want me to email you the full details?`;\n\nreturn {\n  success: true,\n  deal_id: rec.id,\n  speech,\n  deal: rec\n};"
      },
